+reg  [32:0] R;
+reg  [17:0] tbase;
+reg  [3:0]  lw, lh;
+reg         clu, clv;
+wire [15:0] tq16 = f16dec(tq) >> 12, mq16 = f16dec(mq) >> 12, bq16 = f16dec(bq) >> 12;
+
+// the reciprocal's normalization
+wire [35:0] a2abs = a2[35] ? -a2 : a2;
+integer bi;
+reg  [5:0]  Lc;
+always @(*) begin
+	Lc = 6'd0;
+	for (bi = 0; bi < 36; bi = bi + 1) if (a2abs[bi]) Lc = bi + 1;
+end
+wire [35:0] a2norm = (Lc <= 6'd32) ? (a2abs << (6'd32 - Lc)) : (a2abs >> (Lc - 6'd32));
+
+// ---------------------------------------------------------------------------------------------------------------
+// The scan
+// ---------------------------------------------------------------------------------------------------------------
+reg  [8:0]  ry;
+reg  [3:0]  rw;
+reg         par;
+reg  [63:0] mask;
+reg         lastv;                       // nxt: the dot after the last colored one (a run goes on there)
+reg  [10:0] nxt, cur_d, segend;
+reg  [15:0] ua, va, ub, vb_;
+reg signed [33:0] du, dv;
+reg signed [38:0] acc_u, acc_v;
+reg  [4:0]  segk;                        // the texture segment's dots, e1 - s0
+reg         s0pt;                        // the division in flight is the run's first dot's (else a segment end's)
+reg signed [63:0] pq, pu, pv;
+wire [5:0]  lb6 = lsb64(mask);
+wire [10:0] dlow = {1'b0, rw, lb6};
+wire [15:0] ptq0 = clampq(pq);
+wire [15:0] ptq = (ptq0 == 16'd0) ? 16'd1 : ptq0;
+wire [31:0] ptu = clampuq(pu);
+wire [31:0] ptv = clampuq(pv);
+
+// ---------------------------------------------------------------------------------------------------------------
+// Multiplier operands
+// ---------------------------------------------------------------------------------------------------------------
+wire signed [17:0] cxrun = $signed({2'b00, cur_d, 5'd0} >> (pm320 ? 0 : 1)) + $signed({13'd0, phalf}) - ttx;
+wire signed [17:0] cyrow = $signed({5'd0, ry, 4'd8}) - tty;
+reg signed [34:0] nd1, nd2;
+reg [1:0] ma;
+always @(*) begin
+	mul_a = 66'sd0; mul_b = 36'sd0;
+	ma = mi[3:2];
+	nd1 = A[ma * 3 + 1] - A[ma * 3];
+	nd2 = A[ma * 3 + 2] - A[ma * 3];
+	case (st)
+	S_VX: if (mi == 4'd0) begin mul_a = v1x - v0x; mul_b = cy_ - v0y; end
+	      else begin mul_a = cx_ - v0x; mul_b = v1y - v0y; end
+	S_EN: if (mi == 4'd0) begin mul_a = et_x; mul_b = {19'd0, eD}; end
+	      else begin mul_a = $signed({5'd0, ey, 4'd8}) - et_y; mul_b = edx; end
+	S_PA: case (mi)
+	      4'd0: begin mul_a = mmx - ttx; mul_b = bby - tty; end
+	      4'd1: begin mul_a = bbx - ttx; mul_b = mmy - tty; end
+	      4'd2: begin mul_a = {50'd0, tu}; mul_b = {20'd0, tq16}; end
+	      4'd3: begin mul_a = {50'd0, mu}; mul_b = {20'd0, mq16}; end
+	      4'd4: begin mul_a = {50'd0, bu}; mul_b = {20'd0, bq16}; end
+	      4'd5: begin mul_a = {50'd0, tv}; mul_b = {20'd0, tq16}; end
+	      4'd6: begin mul_a = {50'd0, mv}; mul_b = {20'd0, mq16}; end
+	      default: begin mul_a = {50'd0, bv}; mul_b = {20'd0, bq16}; end
+	      endcase
+	S_PN: case (mi[1:0])
+	      2'd0: begin mul_a = nd1; mul_b = bby - tty; end
+	      2'd1: begin mul_a = nd2; mul_b = mmy - tty; end
+	      2'd2: begin mul_a = nd2; mul_b = mmx - ttx; end
+	      default: begin mul_a = nd1; mul_b = bbx - ttx; end
+	      endcase
+	S_PG: begin mul_a = mi[0] ? ny[mi[2:1]] : nx[mi[2:1]]; mul_b = {3'd0, R}; end
+	S_RY: begin mul_a = gy[mi[1:0]]; mul_b = cyrow; end
+	S_RX: begin mul_a = gx[mi[1:0]]; mul_b = cxrun; end
+	S_TK: begin mul_a = gx[mi[1:0]] <<< psh; mul_b = {31'd0, segk}; end
+	S_TD: begin mul_a = mi[0] ? ($signed({1'b0, vb_}) - $signed({1'b0, va})) : ($signed({1'b0, ub}) - $signed({1'b0, ua}));
+	            mul_b = {19'd0, rtab(segk)}; end
+	default: ;
+	endcase
+end
+
+// ---------------------------------------------------------------------------------------------------------------
+// Fragments: E (the scan's register) -> F1 the key's leading one, the texel address -> F2 the key -> F4 the texel ->
+// the write
+// ---------------------------------------------------------------------------------------------------------------
+reg         emit;
+reg  [8:0]  e_y;
+reg  [9:0]  e_d;
+reg  [27:0] e_q;
+reg  [15:0] e_u, e_v;
+reg         f_v [1:4];
+reg  [8:0]  f_y [1:4];
+reg  [9:0]  f_d [1:4];
+reg  [27:0] f1_q28;
+reg  [4:0]  f1_p;
+reg  [15:0] f_q [2:4];
+reg  [15:0] f1_u, f1_vv;
+wire [7:0]  ui0 = f1_u[15:8], vi0 = f1_vv[15:8];
+wire [9:0]  umax = (10'd1 << lw) - 10'd1, vmax = (10'd1 << lh) - 10'd1;
+wire [9:0]  ui = clu ? (({2'd0, ui0} > umax) ? umax : {2'd0, ui0}) : ({2'd0, ui0} & umax);
+wire [9:0]  vi = clv ? (({2'd0, vi0} > vmax) ? vmax : {2'd0, vi0}) : ({2'd0, vi0} & vmax);
+assign tex_ra = tbase + ({8'd0, vi} << lw) + {8'd0, ui};
+assign desc_ra = ptid;
+integer fk;
+always @(posedge clk) begin
+	if (rst) begin
+		for (fk = 1; fk <= 4; fk = fk + 1) f_v[fk] <= 1'b0;
+		wr_valid <= 1'b0;
+	end else begin
+		f_v[1] <= emit; f_y[1] <= e_y; f_d[1] <= e_d;
+		f1_q28 <= e_q; f1_p <= msb28(e_q);
+		f1_u <= e_u; f1_vv <= e_v;
+		f_q[2] <= f16pack(f1_q28, f1_p);
+		for (fk = 2; fk <= 4; fk = fk + 1) begin
+			f_v[fk] <= f_v[fk - 1]; f_y[fk] <= f_y[fk - 1]; f_d[fk] <= f_d[fk - 1];
+			if (fk > 2) f_q[fk] <= f_q[fk - 1];
+		end
+		wr_valid  <= f_v[4] && !(texon && tex_rd == 8'd0);
+		wr_row    <= f_y[4];
+		wr_d      <= f_d[4];
+		wr_color  <= texon ? tex_rd : {4'd0, pcol};
+		wr_ztest  <= zen && zt;
+		wr_zwrite <= zen && zt;
+		wr_q      <= f_q[4];
+	end
+end
+wire frag_busy = emit || f_v[1] || f_v[2] || f_v[3] || f_v[4] || wr_valid;
+
+// ---------------------------------------------------------------------------------------------------------------
+// The sequencer
+// ---------------------------------------------------------------------------------------------------------------
+wire [7:0]  utag = unit[7:0];
+wire signed [15:0] ux = unit[63:48], uy = unit[47:32];
+wire [15:0] uq = unit[31:16];
+wire [7:0]  ufl = unit[15:8];
+reg  [11:0] ca;                          // the reset clear's word
+reg  [8:0]  cy2;                         // a clear's row and word
+reg  [3:0]  cw;
+wire signed [36:0] crs = $signed(res[0][36:0]) - $signed(res[1][36:0]);
+wire [36:0] acr = crs[36] ? -crs : crs;
+integer ai;
+always @(posedge clk) begin
+	rc_go <= 1'b0; ed_go <= 1'b0; uv_go <= 1'b0;
+	mk_we <= 1'b0;
+	ln_req <= 1'b0;
+	emit <= 1'b0;
+	if (rst) begin
+		st <= S_RCLR; ca <= 12'd0; popen <= 1'b0; rany <= 1'b0; mi <= 4'd0; texon <= 1'b0;
+	end else case (st)
+	// ---- every mark 0 (after a reset)
+	S_RCLR: begin
+		mk_we <= 1'b1; mk_wa <= ca; mk_wd <= 128'd0;
+		if (ca == 12'd2399) st <= S_IDLE;
+		ca <= ca + 12'd1;
+	end
+	// ---- a unit
+	S_IDLE: if (go) case (utag)
+		8'hF2: begin
+			cx_ <= ux; cy_ <= uy; cq_ <= uq; cgr <= ufl[1];
+			if (ufl[0]) begin
+				if (rany) begin cy2 <= rmin; cw <= 4'd0; c_ret <= S_NEWP; st <= S_CLR; end
+				else st <= S_NEWP;
+			end else if (popen) begin
+				ea_x <= pvx; ea_y <= pvy; eb_x <= ux; eb_y <= uy; e_ret <= S_VX; st <= S_E0;
+			end
+		end
+		8'hF4: begin
+			if (l0) begin v0u <= ux; v0v <= uy; end
+			if (l1) begin v1u <= ux; v1v <= uy; end
+			if (lb) begin vbu <= ux; vbv <= uy; end
+		end
+		8'hF3: if (popen) begin
+			pcol <= unit[59:56]; ptex <= unit[52]; ptid <= unit[47:40];
+			popen <= 1'b0;
+			st <= S_END;
+		end
+		default: ;
+		endcase
+	// ---- clear the marked rows rmin..rmax, then c_ret
+	S_CLR: begin
+		mk_we <= 1'b1; mk_wa <= maddr(cy2, cw, pm320); mk_wd <= 128'd0;
+		if (cw == stride - 4'd1) begin
+			cw <= 4'd0;
+			if (cy2 == rmax) begin rany <= 1'b0; st <= c_ret; end
+			else cy2 <= cy2 + 9'd1;
+		end else cw <= cw + 4'd1;
+	end
+	// ---- a polygon's first corner
+	S_NEWP: begin
+		v0x <= cx_; v0y <= cy_; v0q <= cq_; v0u <= 16'd0; v0v <= 16'd0;
+		pvx <= cx_; pvy <= cy_;
+		pn <= 2'd1; pground <= cgr; pcovers <= 1'b0; pm320 <= mode320;
+		v1ok <= 1'b0; vbok <= 1'b0; cb <= 37'd0;
+		xa_x <= cx_; xa_y <= cy_; xb_x <= cx_; xb_y <= cy_; xc_x <= cx_; xc_y <= cy_; xd_x <= cx_; xd_y <= cy_;
+		l0 <= 1'b1; l1 <= 1'b0; lb <= 1'b0;
+		popen <= 1'b1;
+		st <= S_IDLE;
+	end
+	// ---- a further corner (its side marked): v1 or vb, the extremes
+	S_VX: if (mi == 4'd1) begin mi <= 4'd0; st <= S_VXW; end else mi <= mi + 4'd1;
+	S_VXW: if (mul_empty) begin
+		l0 <= 1'b0; l1 <= 1'b0; lb <= 1'b0;
+		if (!v1ok) begin
+			if (cx_ != v0x || cy_ != v0y) begin
+				v1x <= cx_; v1y <= cy_; v1q <= cq_; v1u <= 16'd0; v1v <= 16'd0; v1ok <= 1'b1; l1 <= 1'b1;
+			end
+		end else if (acr > cb) begin
+			cb <= acr;
+			vbx <= cx_; vby <= cy_; vbq <= cq_; vbu <= 16'd0; vbv <= 16'd0; vbok <= 1'b1; lb <= 1'b1;
+		end
+		if (cx_ < xa_x) begin xa_x <= cx_; xa_y <= cy_; end
+		if (cx_ > xb_x) begin xb_x <= cx_; xb_y <= cy_; end
+		if (cy_ < xc_y) begin xc_x <= cx_; xc_y <= cy_; end
+		if (cy_ > xd_y) begin xd_x <= cx_; xd_y <= cy_; end
+		pvx <= cx_; pvy <= cy_;
+		if (pn != 2'd3) pn <= pn + 2'd1;
+		pground <= pground | cgr;
+		st <= S_IDLE;
+	end
+	// ---- a side: its rows, the first crossing and the step by division, then a mark a row
+	S_E0: if (ea_y == eb_y) st <= e_ret;
+	else begin
+		if (y0u < y1u) pcovers <= 1'b1;
+		if (ys_w >= ye_w) st <= e_ret;
+		else begin
+			et_x <= et_xw; et_y <= et_yw;
+			eD <= $signed({eu_yw[15], eu_yw}) - $signed({et_yw[15], et_yw});
+			edx <= $signed({eu_xw[15], eu_xw}) - $signed({et_xw[15], et_xw});
+			ey <= ys_w[8:0]; eye <= ye_w[8:0];
+			mi <= 4'd0;
+			st <= S_EN;
+		end
+	end
+	S_EN: if (mi == 4'd1) begin mi <= 4'd0; st <= S_ENW; end else mi <= mi + 4'd1;
+	S_ENW: if (mul_empty) begin
+		e0_n <= n0[39] ? -n0 : n0;
+		e1_n <= stp[39] ? -stp : stp;
+		epd <= {6'd0, eD} << psh;
+		ed_go <= 1'b1;
+		st <= S_EDV;
+	end
+	S_EDV: if (e0_done && e1_done && !ed_go) begin
+		eq <= n0[39] ? -$signed({2'b00, e0_q}) - (e0nz ? 34'sd1 : 34'sd0) : $signed({2'b00, e0_q});
+		er <= (n0[39] && e0nz) ? epd - e0_r[22:0] : (n0[39] ? 23'd0 : e0_r[22:0]);
+		eqs <= stp[39] ? -$signed({2'b00, e1_q}) - (e1nz ? 34'sd1 : 34'sd0) : $signed({2'b00, e1_q});
+		ers <= (stp[39] && e1nz) ? epd - e1_r[22:0] : (stp[39] ? 23'd0 : e1_r[22:0]);
+		st <= S_EROW;
+	end
+	S_EROW: if (ey == eye) st <= e_ret;
+	else if (eq >= $signed({23'd0, W})) begin
+		er <= rcar ? rn[22:0] - epd : rn[22:0];
+		eq <= eq + eqs + (rcar ? 34'sd1 : 34'sd0);
+		ey <= ey + 9'd1;
+	end else begin
+		mk_ra <= maddr(ey, eq[33] ? 4'd0 : eq[9:6], pm320);
+		mbit <= eq[33] ? 6'd0 : eq[5:0];
+		medge <= !eq[33];
+		st <= S_MK1;
+	end
+	S_MK1: st <= S_MK2;
+	S_MK2: st <= S_MK3;
+	S_MK3: begin
+		mk_we <= 1'b1; mk_wa <= mk_ra;
+		mk_wd <= {mk_q[127:64] | (medge ? (64'd1 << mbit) : 64'd0), mk_q[63:0] ^ (64'd1 << mbit)};
+		if (!rany || ey < rmin) rmin <= ey;
+		if (!rany || ey > rmax) rmax <= ey;
+		rany <= 1'b1;
+		er <= rcar ? rn[22:0] - epd : rn[22:0];
+		eq <= eq + eqs + (rcar ? 34'sd1 : 34'sd0);
+		ey <= ey + 9'd1;
+		st <= S_EROW;
+	end
+	// ---- the end: the closing side, then a LINE, nothing, or the planes and the scan
+	S_END: if (pn == 2'd3) begin
+		ea_x <= pvx; ea_y <= pvy; eb_x <= v0x; eb_y <= v0y; e_ret <= S_END2; st <= S_E0;
+	end else st <= S_END2;
+	S_END2: if (pn == 2'd1) begin
+		if (rany) begin cy2 <= rmin; cw <= 4'd0; c_ret <= S_IDLE; st <= S_CLR; end
+		else st <= S_IDLE;
+	end else if (pn == 2'd2 || !pcovers) begin
+		if (pn == 2'd2) begin
+			ln_x0 <= clx(v0x); ln_y0 <= cly(v0y, H); ln_x1 <= clx(pvx); ln_y1 <= cly(pvy, H);
+		end else if ($signed({xb_x[15], xb_x}) - $signed({xa_x[15], xa_x}) >= $signed({xd_y[15], xd_y}) - $signed({xc_y[15], xc_y})) begin
+			ln_x0 <= clx(xa_x); ln_y0 <= cly(xa_y, H); ln_x1 <= clx(xb_x); ln_y1 <= cly(xb_y, H);
+		end else begin
+			ln_x0 <= clx(xc_x); ln_y0 <= cly(xc_y, H); ln_x1 <= clx(xd_x); ln_y1 <= cly(xd_y, H);
+		end
+		ln_col <= {4'd0, pcol};
+		ln_req <= 1'b1;
+		if (rany) begin cy2 <= rmin; cw <= 4'd0; c_ret <= S_IDLE; st <= S_CLR; end
+		else st <= S_IDLE;
+	end else st <= S_P0;
+	S_P0: begin
+		ttx <= v0x; tty <= v0y; tq <= v0q; tu <= v0u; tv <= v0v;
+		if (v1ok) begin mmx <= v1x; mmy <= v1y; mq <= v1q; mu <= v1u; mv <= v1v; end
+		else begin mmx <= v0x; mmy <= v0y; mq <= v0q; mu <= v0u; mv <= v0v; end
+		if (vbok) begin bbx <= vbx; bby <= vby; bq <= vbq; bu <= vbu; bv <= vbv; end
+		else begin bbx <= v0x; bby <= v0y; bq <= v0q; bu <= v0u; bv <= v0v; end
+		texon <= ptex && texen;
+		na <= (ptex && texen) ? 2'd3 : 2'd1;
+		zt <= !pground;
+		mi <= 4'd0;
+		st <= S_PA;
+	end
+	S_PA: if (mi == ((na == 2'd3) ? 4'd7 : 4'd1)) begin mi <= 4'd0; st <= S_PAW; end else mi <= mi + 4'd1;
+	S_PAW: if (mul_empty) begin
+		a2 <= $signed(res[0][35:0]) - $signed(res[1][35:0]);
+		A[0] <= {6'd0, f16dec(tq)}; A[1] <= {6'd0, f16dec(mq)}; A[2] <= {6'd0, f16dec(bq)};
+		A[3] <= res[2][33:0]; A[4] <= res[3][33:0]; A[5] <= res[4][33:0];
+		A[6] <= res[5][33:0]; A[7] <= res[6][33:0]; A[8] <= res[7][33:0];
+		st <= S_PN;
+		mi <= 4'd0;
+	end
+	S_PN: if (a2 == 36'sd0) begin
+		for (ai = 0; ai < 3; ai = ai + 1) begin gx[ai] <= 64'sd0; gy[ai] <= 64'sd0; end
+		st <= S_SC0;
+	end else if (mi == {na, 2'b00} - 4'd1) begin
+		mi <= 4'd0;
+		L <= Lc; rc_m <= a2norm[31:0]; rc_go <= 1'b1;
+		st <= S_PNW;
+	end else mi <= mi + 4'd1;
+	S_PNW: if (mul_empty) begin
+		for (ai = 0; ai < 3; ai = ai + 1) begin
+			nx[ai] <= $signed(res[4 * ai][51:0]) - $signed(res[4 * ai + 1][51:0]);
+			ny[ai] <= $signed(res[4 * ai + 2][51:0]) - $signed(res[4 * ai + 3][51:0]);
+		end
+		st <= S_PRC;
+	end
+	S_PRC: if (rc_done && !rc_go) begin R <= rc_q; mi <= 4'd0; st <= S_PG; end
+	S_PG: if (mi == {1'b0, na, 1'b0} - 4'd1) begin mi <= 4'd0; st <= S_PGW; end else mi <= mi + 4'd1;
+	S_PGW: if (mul_empty) begin
+		for (ai = 0; ai < 3; ai = ai + 1) begin
+			gx[ai] <= a2[35] ? -(res[2 * ai] >>> (L + 6'd7)) : (res[2 * ai] >>> (L + 6'd7));
+			gy[ai] <= a2[35] ? -(res[2 * ai + 1] >>> (L + 6'd7)) : (res[2 * ai + 1] >>> (L + 6'd7));
+		end
+		st <= S_SC0;
+	end
+	// ---- the scan: rows rmin..rmax, a word at a time
+	S_SC0: begin
+		tbase <= {desc_rd[25:24], desc_rd[23:16], desc_rd[15:8]};
+		lw <= 4'd3 + {1'b0, desc_rd[2:0]};
+		lh <= 4'd3 + {1'b0, desc_rd[5:3]};
+		clu <= desc_rd[6]; clv <= desc_rd[7];
+		ry <= rmin;
+		st <= rany ? S_ROW : S_IDLE;
+	end
+	S_ROW: if (ry > rmax) begin rany <= 1'b0; st <= S_DRAIN; end
+	else begin mi <= 4'd0; st <= S_RY; end
+	S_RY: if (mi == {2'b00, na} - 4'd1) begin mi <= 4'd0; st <= S_RYW; end else mi <= mi + 4'd1;
+	S_RYW: if (mul_empty) begin
+		for (ai = 0; ai < 3; ai = ai + 1) gyt[ai] <= res[ai][63:0];
+		rw <= 4'd0; par <= 1'b0; lastv <= 1'b0;
+		st <= S_W0;
+	end
+	S_W0: begin mk_ra <= maddr(ry, rw, pm320); st <= S_W1; end
+	S_W1: st <= S_W2;
+	S_W2: st <= S_W3;
+	S_W3: begin
+		mask <= (pxor(mk_q[63:0]) ^ {64{par}}) | mk_q[127:64];
+		par <= par ^ (^mk_q[63:0]);
+		mk_we <= 1'b1; mk_wa <= mk_ra; mk_wd <= 128'd0;
+		st <= S_DOT;
+	end
+	S_DOT: if (mask == 64'd0) begin
+		if (rw == stride - 4'd1) begin ry <= ry + 9'd1; st <= S_ROW; end
+		else begin rw <= rw + 4'd1; st <= S_W0; end
+	end else if (lastv && dlow == nxt && (!texon || dlow <= segend)) begin
+		emit <= 1'b1;
+		e_y <= ry; e_d <= dlow[9:0];
+		e_q <= clampq28(ev[0]);
+		e_u <= ua + acc_u[31:16];
+		e_v <= va + acc_v[31:16];
+		for (ai = 0; ai < 3; ai = ai + 1) ev[ai] <= ev[ai] + (gx[ai] <<< psh);
+		acc_u <= acc_u + du; acc_v <= acc_v + dv;
+		mask <= mask & (mask - 64'd1);
+		nxt <= dlow + 11'd1;
+	end else if (lastv && dlow == nxt) begin
+		// the run goes on into the next texture segment: its start is the last segment's end
+		cur_d <= dlow; ua <= ub; va <= vb_;
+		segk <= 5'd16 - {1'b0, dlow[3:0]};
+		mi <= 4'd0;
+		st <= S_TK;
+	end else begin
+		cur_d <= dlow;
+		mi <= 4'd0;
+		st <= S_RX;
+	end
+	// a run's first dot: the planes there
+	S_RX: if (mi == {2'b00, na} - 4'd1) begin mi <= 4'd0; st <= S_RXW; end else mi <= mi + 4'd1;
+	S_RXW: if (mul_empty) begin
+		for (ai = 0; ai < 3; ai = ai + 1) ev[ai] <= ($signed(A[3 * ai]) <<< G) + res[ai][63:0] + gyt[ai];
+		if (texon) st <= S_TS0;
+		else begin lastv <= 1'b1; nxt <= cur_d; st <= S_DOT; end
+	end
+	// texture: u, v at the run's first dot, then at each segment's end (the next 16-dot boundary)
+	S_TS0: begin
+		pq <= ev[0]; pu <= ev[1]; pv <= ev[2];
+		s0pt <= 1'b1;
+		st <= S_TS0W;
+	end
+	S_TS0W: begin
+		du_n <= ptu; dv_n <= ptv; duv_d <= ptq;
+		uv_go <= 1'b1;
+		st <= S_TKDW;
+	end
+	S_TK: if (mi == 4'd2) begin mi <= 4'd0; st <= S_TKW; end else mi <= mi + 4'd1;
+	S_TKW: if (mul_empty) begin
+		pq <= ev[0] + res[0][63:0]; pu <= ev[1] + res[1][63:0]; pv <= ev[2] + res[2][63:0];
+		s0pt <= 1'b0;
+		st <= S_TS0W;
+	end
+	S_TKDW: if (du_done && dv_done && !uv_go) begin
+		if (s0pt) begin
+			ua <= (ptu >= {ptq, 16'd0}) ? 16'hFFFF : du_q;
+			va <= (ptv >= {ptq, 16'd0}) ? 16'hFFFF : dv_q;
+			segk <= 5'd16 - {1'b0, cur_d[3:0]};
+			mi <= 4'd0;
+			st <= S_TK;
+		end else begin
+			ub <= (ptu >= {ptq, 16'd0}) ? 16'hFFFF : du_q;
+			vb_ <= (ptv >= {ptq, 16'd0}) ? 16'hFFFF : dv_q;
+			mi <= 4'd0;
+			st <= S_TD;
+		end
+	end
+	S_TD: if (mi == 4'd1) begin mi <= 4'd0; st <= S_TDW; end else mi <= mi + 4'd1;
+	S_TDW: if (mul_empty) begin
+		du <= res[0][33:0]; dv <= res[1][33:0];
+		acc_u <= 39'sd0; acc_v <= 39'sd0;
+		segend <= cur_d | 11'd15;
+		lastv <= 1'b1; nxt <= cur_d;
+		st <= S_DOT;
+	end
+	S_DRAIN: if (!frag_busy) st <= S_IDLE;
+	default: st <= S_IDLE;
+	endcase
+end
+
+endmodule
