+// gpu3_pfill: the scanline polygon fill (K2_GPU3; model fpga/sim/gpu3/gpu3_ref.py GPU.pf_vertex / pf_end, bit for bit).
+// The SceneEngine port's polygons (gpu3_seport.v units: $F2 a corner, $F4 its U V, $F3 the end), any shape, any number
+// of corners. Each corner's side from the previous corner (the closing side at the end) marks every view row whose
+// center it crosses: at the crossing dot c = floor(X / P) (the first row's quotient and remainder by division, then a
+// quotient / remainder step a row) the crossing bit flips and the edge bit sets (c < 0: dot 0's crossing bit only;
+// c >= W: nothing). The marks: 2,400 words of 64 dots (crossing bits 63:0, edge bits 127:64), a view row 10 words at
+// 640, 5 at 320. At the end each marked row is scanned a word at a time: inside flips at each crossing bit, a dot inside
+// or with its edge bit is colored (fsw.asm's PFill rule), the word written back 0. Every dot takes the polygon's planes
+// (the depth key; U x Q, V x Q when textured) from three corners: v0, the first corner off v0 (v1), the corner farthest
+// off their line (vb, by |cross|), computed as gpu3_tri's planes; texture segments end at the next 16-dot boundary.
+// Two corners, or sides crossing no row center: a LINE request to the core (no depth). A dot a clock; the fragments as
+// gpu3_tri's: the key encoded, the texel (3 clocks), one write to gpu3_fb.
+`timescale 1ns / 1ps
+
+module gpu3_pfill (
+	input  wire        clk,
+	input  wire        rst,              // also a GPU RESET: every mark cleared before the next unit
+	input  wire        go,               // a unit for the fill: $F2, $F4 or $F3
+	input  wire [63:0] unit,
+	output wire        idle,
+	input  wire        mode320,
+	input  wire [8:0]  view_rows,        // H, the core's
+	input  wire        zen, texen,
+	// a LINE for the core: 640-space dots, view rows
+	output reg         ln_req,
+	output reg  [9:0]  ln_x0, ln_x1,
+	output reg  [8:0]  ln_y0, ln_y1,
+	output reg  [7:0]  ln_col,
+	// memories (read latency 3)
+	output wire [7:0]  desc_ra,  input wire [31:0] desc_rd,
+	output wire [17:0] tex_ra,   input wire [7:0]  tex_rd,
+	// gpu3_fb writes, a dot each
+	output reg         wr_valid,
+	output reg  [8:0]  wr_row,
+	output reg  [9:0]  wr_d,
+	output reg  [7:0]  wr_color,
+	output reg         wr_ztest,
+	output reg         wr_zwrite,
+	output reg  [15:0] wr_q
+);
+
+localparam G = 24;
+localparam [5:0] S_RCLR = 0, S_IDLE = 1, S_NEWP = 2, S_CLR = 3, S_VX = 4, S_VXW = 5, S_E0 = 6, S_EN = 7, S_ENW = 8,
+	S_EDV = 9, S_EROW = 10, S_MK1 = 11, S_MK2 = 12, S_MK3 = 13, S_END = 14, S_END2 = 15, S_P0 = 16, S_PA = 17,
+	S_PAW = 18, S_PN = 19, S_PNW = 20, S_PRC = 21, S_PG = 22, S_PGW = 23, S_SC0 = 24, S_ROW = 25, S_RY = 26,
+	S_RYW = 27, S_W0 = 28, S_W1 = 29, S_W2 = 30, S_W3 = 31, S_DOT = 32, S_RX = 33, S_RXW = 34, S_TS0 = 35,
+	S_TS0W = 36, S_TK = 37, S_TKW = 38, S_TKDW = 39, S_TD = 40, S_TDW = 41, S_DRAIN = 42;
+reg  [5:0]  st, e_ret, c_ret;
+assign idle = st == S_IDLE;
+
+// ---------------------------------------------------------------------------------------------------------------
+// The multiplier (gpu3_tri's scheme): a pair a clock in the issuing states, the products written back by index
+// ---------------------------------------------------------------------------------------------------------------
+reg  signed [65:0]  mul_a;
+reg  signed [35:0]  mul_b;
+wire signed [101:0] mul_p;
+gpu3_mul MUL (.clk(clk), .a(mul_a), .b(mul_b), .p(mul_p));
+reg  [3:0]  mi;
+wire        issuing = (st == S_VX) || (st == S_EN) || (st == S_PA) || (st == S_PN) || (st == S_PG) || (st == S_RY) ||
+                      (st == S_RX) || (st == S_TK) || (st == S_TD);
+reg  [3:0]  t_v;
+reg  [3:0]  t_i [0:3];
+reg  signed [101:0] res [0:15];
+always @(posedge clk) begin
+	t_v <= rst ? 4'd0 : {t_v[2:0], issuing};
+	t_i[0] <= mi; t_i[1] <= t_i[0]; t_i[2] <= t_i[1]; t_i[3] <= t_i[2];
+	if (t_v[3]) res[t_i[3]] <= mul_p;
+end
+wire        mul_empty = (t_v == 4'd0);
+
+// ---------------------------------------------------------------------------------------------------------------
+// Dividers: the reciprocal, a side's first row and its step, u and v
+// ---------------------------------------------------------------------------------------------------------------
+reg         rc_go;
+reg  [31:0] rc_m;
+wire [32:0] rc_q;
+wire [63:0] rc_r;
+wire        rc_done;
