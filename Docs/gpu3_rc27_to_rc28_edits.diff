+	.qbits(7'd33), .q(rc_q), .r(rc_r), .done(rc_done));
+reg         ed_go;
+reg  [39:0] e0_n, e1_n;
+reg  [22:0] epd;
+wire [31:0] e0_q, e1_q;
+wire [39:0] e0_r, e1_r;
+wire        e0_done, e1_done;
+gpu3_div #(.NW(40), .DW(23), .QW(32)) DE0 (.clk(clk), .start(ed_go), .n(e0_n), .d(epd), .qbits(7'd32),
+	.q(e0_q), .r(e0_r), .done(e0_done));
+gpu3_div #(.NW(40), .DW(23), .QW(32)) DE1 (.clk(clk), .start(ed_go), .n(e1_n), .d(epd), .qbits(7'd32),
+	.q(e1_q), .r(e1_r), .done(e1_done));
+reg         uv_go;
+reg  [31:0] du_n, dv_n;
+reg  [15:0] duv_d;
+wire [15:0] du_q, dv_q;
+wire [31:0] du_r, dv_r;
+wire        du_done, dv_done;
+gpu3_div #(.NW(32), .DW(16), .QW(16)) DDU (.clk(clk), .start(uv_go), .n(du_n), .d(duv_d), .qbits(7'd16),
+	.q(du_q), .r(du_r), .done(du_done));
+gpu3_div #(.NW(32), .DW(16), .QW(16)) DDV (.clk(clk), .start(uv_go), .n(dv_n), .d(duv_d), .qbits(7'd16),
+	.q(dv_q), .r(dv_r), .done(dv_done));
+
+// ---------------------------------------------------------------------------------------------------------------
+// The marks: crossing bits 63:0, edge bits 127:64; read two clocks after the address
+// ---------------------------------------------------------------------------------------------------------------
+(* ram_style = "block" *) reg [127:0] mk [0:2399];
+reg  [11:0] mk_ra, mk_wa;
+reg         mk_we;
+reg  [127:0] mk_wd, mk_q0, mk_q;
+integer mj;
+initial for (mj = 0; mj < 2400; mj = mj + 1) mk[mj] = 128'd0;
+always @(posedge clk) begin
+	if (mk_we) mk[mk_wa] <= mk_wd;
+	mk_q0 <= mk[mk_ra];
+	mk_q <= mk_q0;
+end
+// word w of view row y: y x 10 + w at 640, y x 5 + w at 320
+function [11:0] maddr; input [8:0] yy; input [3:0] ww; input m3;
+	maddr = m3 ? ({3'd0, yy} << 2) + {3'd0, yy} + {8'd0, ww} : ({3'd0, yy} << 3) + ({3'd0, yy} << 1) + {8'd0, ww};
+endfunction
+
+// ---------------------------------------------------------------------------------------------------------------
+// The polygon
+// ---------------------------------------------------------------------------------------------------------------
+reg         popen, pground, pcovers, pm320, ptex;
+reg  [1:0]  pn;                          // corners so far: 1, 2, 3 (3 or more)
+reg  [3:0]  pcol;
+reg  [7:0]  ptid;
+reg signed [15:0] v0x, v0y, v1x, v1y, vbx, vby, pvx, pvy;
+reg  [15:0] v0q, v1q, vbq, v0u, v0v, v1u, v1v, vbu, vbv;
+reg         v1ok, vbok, l0, l1, lb;      // l0 / l1 / lb: the last corner is v0 / v1 / vb (its U V go there)
+reg  [36:0] cb;                          // vb's |cross|
+reg signed [15:0] xa_x, xa_y, xb_x, xb_y, xc_x, xc_y, xd_x, xd_y;   // least x, most x, least y, most y
+reg  [8:0]  rmin, rmax;
+reg         rany;
+// the current corner
+reg signed [15:0] cx_, cy_;
+reg  [15:0] cq_;
+reg         cgr;
+
+wire [10:0] W = pm320 ? 11'd320 : 11'd640;
+wire [3:0]  stride = pm320 ? 4'd5 : 4'd10;
+wire [2:0]  psh = pm320 ? 3'd5 : 3'd4;
+wire [4:0]  phalf = pm320 ? 5'd16 : 5'd8;
+wire [8:0]  H = view_rows;
+
+// ---------------------------------------------------------------------------------------------------------------
+// A side: a to b
+// ---------------------------------------------------------------------------------------------------------------
+reg signed [15:0] ea_x, ea_y, eb_x, eb_y;
+wire        a_top = ea_y < eb_y;
+wire signed [15:0] et_xw = a_top ? ea_x : eb_x, et_yw = a_top ? ea_y : eb_y;
+wire signed [15:0] eu_xw = a_top ? eb_x : ea_x, eu_yw = a_top ? eb_y : ea_y;
+// rows: ceil((y - 8) / 16) = (y + 7) >> 4
+wire signed [12:0] y0u = ($signed({et_yw[15], et_yw}) + 17'sd7) >>> 4;
+wire signed [12:0] y1u = ($signed({eu_yw[15], eu_yw}) + 17'sd7) >>> 4;
+wire signed [12:0] ys_w = (y0u < 13'sd0) ? 13'sd0 : y0u;
+wire signed [12:0] ye_w = (y1u > $signed({4'd0, H})) ? $signed({4'd0, H}) : y1u;
+reg signed [15:0] et_x, et_y;
+reg  [16:0] eD;
+reg signed [16:0] edx;
+reg  [8:0]  ey, eye;
+reg signed [33:0] eq, eqs;
+reg  [22:0] er, ers;
+reg  [5:0]  mbit;
+reg         medge;
+wire [23:0] rn = {1'b0, er} + {1'b0, ers};
+wire        rcar = rn >= {1'b0, epd};
+wire signed [39:0] n0 = $signed(res[0][39:0]) + $signed(res[1][39:0]);
+wire signed [39:0] stp = $signed({{19{edx[16]}}, edx, 4'd0});
+wire        e0nz = e0_r[22:0] != 23'd0, e1nz = e1_r[22:0] != 23'd0;
+
+// ---------------------------------------------------------------------------------------------------------------
+// The planes (gpu3_tri's): attribute a of t / m / b at A[3a], A[3a + 1], A[3a + 2] (the key, U x Q, V x Q)
+// ---------------------------------------------------------------------------------------------------------------
+function [27:0] f16dec; input [15:0] c;
+	begin
+		if (c[15:12] == 4'd0) f16dec = {14'd0, c[11:0], 2'd0};
+		else if (c[15:12] == 4'd15) f16dec = 28'hFFFFFFF;
+		else f16dec = {15'd0, 1'b1, c[11:0]} << (c[15:12] + 4'd1);
+	end
+endfunction
+function [27:0] clampq28; input signed [63:0] e;
+	reg signed [39:0] s;
+	begin s = e >>> G; clampq28 = (s < 0) ? 28'd0 : ((s > 40'sd268435455) ? 28'hFFFFFFF : s[27:0]); end
+endfunction
+function [4:0] msb28; input [27:0] q;
+	integer b;
+	begin msb28 = 5'd0; for (b = 0; b < 28; b = b + 1) if (q[b]) msb28 = b; end
+endfunction
+function [15:0] f16pack; input [27:0] q; input [4:0] p;
+	reg [27:0] m;
+	begin
+		if (q == 28'hFFFFFFF) f16pack = 16'hFFFF;
+		else if (p < 5'd14) f16pack = {4'd0, q[13:2]};
+		else begin m = q >> (p - 5'd12); f16pack = {p[3:0] - 4'd13, m[11:0]}; end
+	end
+endfunction
+function [15:0] clampq; input signed [63:0] e;
+	reg [27:0] q;
+	begin q = clampq28(e); clampq = q[27:12]; end
+endfunction
+function [31:0] clampuq; input signed [63:0] e;
+	reg signed [39:0] s;
+	begin s = e >>> G; clampuq = (s < 0) ? 32'd0 : s[31:0]; end
+endfunction
+function [16:0] rtab; input [4:0] k;
+	case (k)
+		5'd1: rtab = 17'd65536; 5'd2: rtab = 17'd32768; 5'd3: rtab = 17'd21845; 5'd4: rtab = 17'd16384;
+		5'd5: rtab = 17'd13107; 5'd6: rtab = 17'd10923; 5'd7: rtab = 17'd9362;  5'd8: rtab = 17'd8192;
+		5'd9: rtab = 17'd7282;  5'd10: rtab = 17'd6554; 5'd11: rtab = 17'd5958; 5'd12: rtab = 17'd5461;
+		5'd13: rtab = 17'd5041; 5'd14: rtab = 17'd4681; 5'd15: rtab = 17'd4369; 5'd16: rtab = 17'd4096;
