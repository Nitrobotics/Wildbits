+endfunction
+function [8:0] cly; input signed [15:0] y; input [8:0] h;
+	reg signed [15:0] s;
+	begin s = y >>> 4; cly = (s < 16'sd0) ? 9'd0 : ((s > $signed({7'd0, h}) - 16'sd1) ? h - 9'd1 : s[8:0]); end
+endfunction
